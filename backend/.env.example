# 토스페이먼츠 설정 (개발자센터에서 발급받으세요)
TOSS_PAYMENTS_SECRET_KEY=test_sk_your_secret_key_here
TOSS_PAYMENTS_CLIENT_KEY=test_ck_your_client_key_here

# 결제 페이지 URL 설정
TOSS_PAYMENTS_CHECKOUT_URL=http://localhost:3000/payments
TOSS_PAYMENTS_SUCCESS_URL=http://localhost:3000/payments/success
TOSS_PAYMENTS_FAIL_URL=http://localhost:3000/payments/fail

# 프론트엔드에서도 클라이언트 키 필요
# frontend/.env.local에 설정:
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_client_key_here
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080