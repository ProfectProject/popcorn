# 🚀 Popcorn Backend 극한 테스트용 Dockerfile
# 5백만명 동시 접속 + 24시간 지속 테스트 최적화

FROM eclipse-temurin:17-jdk-jammy as builder

# 빌드 의존성 설치
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 작업 디렉토리 설정
WORKDIR /app

# Gradle 래퍼 복사
COPY gradlew .
COPY gradle gradle/
RUN chmod +x gradlew

# 의존성 캐싱을 위한 build.gradle 복사
COPY build.gradle .
COPY settings.gradle .

# 의존성 다운로드 (캐시 레이어)
RUN ./gradlew dependencies --no-daemon

# 소스 코드 복사
COPY src src/
COPY k6-tests k6-tests/
COPY jmeter-tests jmeter-tests/
COPY monitoring monitoring/

# 애플리케이션 빌드 (테스트 스킵하여 빠른 빌드)
RUN ./gradlew bootJar -x test --no-daemon

# 실행 스테이지
FROM eclipse-temurin:17-jdk-jammy

# 극한 성능을 위한 패키지 설치
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    htop \
    netcat \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 애플리케이션 사용자 생성
RUN groupadd -r popcorn && useradd -r -g popcorn popcorn

# 작업 디렉토리
WORKDIR /app

# 빌드된 JAR 파일 복사
COPY --from=builder /app/build/libs/*.jar app.jar

# 로그 디렉토리 생성
RUN mkdir -p /app/logs && chown popcorn:popcorn /app/logs

# JVM 극한 최적화 설정
ENV JAVA_OPTS="-server \
    -Xms2g \
    -Xmx8g \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=100 \
    -XX:+UseStringDeduplication \
    -XX:+OptimizeStringConcat \
    -XX:+UseCompressedOops \
    -XX:+UseCompressedClassPointers \
    -XX:+AlwaysPreTouch \
    -XX:+UseLargePages \
    -XX:+DisableExplicitGC \
    -XX:+UnlockExperimentalVMOptions \
    -XX:+EnableJVMCI \
    -XX:+UseJVMCICompiler \
    -XX:+UnlockDiagnosticVMOptions \
    -XX:+LogVMOutput \
    -XX:LogFile=/app/logs/jvm.log \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/app/logs/ \
    -Djava.awt.headless=true \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.jmx.enabled=false \
    -Dmanagement.endpoint.shutdown.enabled=false"

# 극한 테스트용 Spring 프로파일
ENV SPRING_PROFILES_ACTIVE="extreme-chaos"

# 네트워크 최적화
ENV CATALINA_OPTS="-Djava.net.preferIPv4Stack=true \
    -Dcom.sun.management.jmxremote \
    -Dcom.sun.management.jmxremote.port=9090 \
    -Dcom.sun.management.jmxremote.local.only=false \
    -Dcom.sun.management.jmxremote.authenticate=false \
    -Dcom.sun.management.jmxremote.ssl=false"

# 헬스체크 설정
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# 포트 노출
EXPOSE 8080 9090

# 사용자 변경
USER popcorn

# 애플리케이션 실행
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS $CATALINA_OPTS -jar app.jar"]

# 라벨 추가
LABEL maintainer="Popcorn Extreme Test Team"
LABEL description="Popcorn Backend optimized for extreme load testing (5M users, 24h endurance)"
LABEL version="extreme-1.0"
