package com.popcorn.demo.domain.payment.controller;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.ArgumentMatchers.eq;
import static org.mockito.Mockito.doNothing;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.popcorn.demo.domain.order.entity.OrderStatus;
import com.popcorn.demo.domain.payment.dto.request.PaymentStatusUpdateRequest;
import com.popcorn.demo.domain.payment.entity.PaymentMethod;
import com.popcorn.demo.domain.payment.entity.PaymentStatus;
import com.popcorn.demo.domain.payment.service.PaymentCommandService;
import com.popcorn.demo.domain.payment.service.PaymentQueryService;

@WebMvcTest(PaymentController.class)
class PaymentControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @MockBean
    private PaymentCommandService paymentCommandService;

    @MockBean
    private PaymentQueryService paymentQueryService;

    @Test
    void getPaymentsByOrderReturnsPaymentList() throws Exception {
        // Given
        UUID orderId = UUID.randomUUID();
        UUID paymentId = UUID.randomUUID();
        LocalDateTime now = LocalDateTime.now();

        PaymentQueryService.PaymentDetailResult result = PaymentQueryService.PaymentDetailResult.builder()
                .paymentId(paymentId)
                .orderId(orderId)
                .method(PaymentMethod.CARD)
                .paymentStatus(PaymentStatus.PAID)
                .amount(10000)
                .approvedAt(now)
                .createdAt(now)
                .updatedAt(now)
                .orderStatus(OrderStatus.COMPLETED)
                .qrAvailable(false)
                .build();

        when(paymentQueryService.getPaymentsByOrder(orderId)).thenReturn(List.of(result));

        // When & Then
        mockMvc.perform(get("/api/v1/orders/{orderId}/payments", orderId))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.count").value(1))
                .andExpect(jsonPath("$.data.items[0].paymentId").value(paymentId.toString()))
                .andExpect(jsonPath("$.data.items[0].orderId").value(orderId.toString()))
                .andExpect(jsonPath("$.data.items[0].method").value("CARD"))
                .andExpect(jsonPath("$.data.items[0].status").value("PAID"))
                .andExpect(jsonPath("$.data.items[0].amount").value(10000));
    }

    @Test
    void getPaymentReturnsPaymentDetail() throws Exception {
        // Given
        UUID paymentId = UUID.randomUUID();
        UUID orderId = UUID.randomUUID();
        LocalDateTime now = LocalDateTime.now();

        PaymentQueryService.PaymentDetailResult result = PaymentQueryService.PaymentDetailResult.builder()
                .paymentId(paymentId)
                .orderId(orderId)
                .method(PaymentMethod.CARD)
                .paymentStatus(PaymentStatus.PAID)
                .amount(15000)
                .approvedAt(now)
                .createdAt(now)
                .updatedAt(now)
                .orderStatus(OrderStatus.COMPLETED)
                .qrAvailable(true)
                .qrCode("sample-qr-code")
                .qrExpiresAt(now.plusHours(1))
                .build();

        when(paymentQueryService.getPayment(paymentId)).thenReturn(result);

        // When & Then
        mockMvc.perform(get("/api/v1/payments/{paymentId}", paymentId))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.paymentId").value(paymentId.toString()))
                .andExpect(jsonPath("$.data.orderId").value(orderId.toString()))
                .andExpect(jsonPath("$.data.method").value("CARD"))
                .andExpect(jsonPath("$.data.status").value("PAID"))
                .andExpect(jsonPath("$.data.amount").value(15000))
                .andExpect(jsonPath("$.data.qrAvailable").value(true))
                .andExpect(jsonPath("$.data.qrCode").value("sample-qr-code"));
    }

    @Test
    void updatePaymentStatusUpdatesStatus() throws Exception {
        // Given
        UUID paymentId = UUID.randomUUID();
        UUID orderId = UUID.randomUUID();
        LocalDateTime now = LocalDateTime.now();

        PaymentStatusUpdateRequest request = PaymentStatusUpdateRequest.builder()
                .status("PAID")
                .build();

        PaymentCommandService.PaymentDetailResult result = PaymentCommandService.PaymentDetailResult.builder()
                .paymentId(paymentId)
                .orderId(orderId)
                .method(PaymentMethod.CARD)
                .paymentStatus(PaymentStatus.PAID)
                .amount(20000)
                .approvedAt(now)
                .createdAt(now)
                .updatedAt(now)
                .orderStatus(OrderStatus.COMPLETED)
                .build();

        when(paymentCommandService.updatePaymentStatus(eq(paymentId), anyString())).thenReturn(result);

        // When & Then
        mockMvc.perform(patch("/api/v1/payments/{paymentId}/status", paymentId)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.paymentId").value(paymentId.toString()))
                .andExpect(jsonPath("$.data.status").value("PAID"))
                .andExpect(jsonPath("$.data.amount").value(20000))
                .andExpect(jsonPath("$.data.qrAvailable").value(false));
    }

    @Test
    void deletePaymentDeletesSuccessfully() throws Exception {
        // Given
        UUID paymentId = UUID.randomUUID();
        doNothing().when(paymentCommandService).deletePayment(paymentId);

        // When & Then
        mockMvc.perform(delete("/api/v1/payments/{paymentId}", paymentId))
                .andExpect(status().isNoContent());
    }

    @Test
    void getPaymentsByOrderReturnsEmptyList() throws Exception {
        // Given
        UUID orderId = UUID.randomUUID();
        when(paymentQueryService.getPaymentsByOrder(orderId)).thenReturn(List.of());

        // When & Then
        mockMvc.perform(get("/api/v1/orders/{orderId}/payments", orderId))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.count").value(0))
                .andExpect(jsonPath("$.data.items").isEmpty());
    }

    @Test
    void updatePaymentStatusWithFailedStatus() throws Exception {
        // Given
        UUID paymentId = UUID.randomUUID();
        UUID orderId = UUID.randomUUID();
        LocalDateTime now = LocalDateTime.now();

        PaymentStatusUpdateRequest request = PaymentStatusUpdateRequest.builder()
                .status("FAILED")
                .build();

        PaymentCommandService.PaymentDetailResult result = PaymentCommandService.PaymentDetailResult.builder()
                .paymentId(paymentId)
                .orderId(orderId)
                .method(PaymentMethod.CARD)
                .paymentStatus(PaymentStatus.FAILED)
                .amount(5000)
                .approvedAt(null)
                .createdAt(now)
                .updatedAt(now)
                .orderStatus(OrderStatus.CANCELLED)
                .build();

        when(paymentCommandService.updatePaymentStatus(eq(paymentId), anyString())).thenReturn(result);

        // When & Then
        mockMvc.perform(patch("/api/v1/payments/{paymentId}/status", paymentId)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.status").value("FAILED"))
                .andExpect(jsonPath("$.data.orderStatus").value("CANCELLED"));
    }

    @Test
    void updatePaymentStatusWithCancelledStatus() throws Exception {
        // Given
        UUID paymentId = UUID.randomUUID();
        UUID orderId = UUID.randomUUID();
        LocalDateTime now = LocalDateTime.now();

        PaymentStatusUpdateRequest request = PaymentStatusUpdateRequest.builder()
                .status("CANCELLED")
                .build();

        PaymentCommandService.PaymentDetailResult result = PaymentCommandService.PaymentDetailResult.builder()
                .paymentId(paymentId)
                .orderId(orderId)
                .method(PaymentMethod.CARD)
                .paymentStatus(PaymentStatus.CANCELLED)
                .amount(7000)
                .approvedAt(null)
                .createdAt(now)
                .updatedAt(now)
                .orderStatus(OrderStatus.CANCELLED)
                .build();

        when(paymentCommandService.updatePaymentStatus(eq(paymentId), anyString())).thenReturn(result);

        // When & Then
        mockMvc.perform(patch("/api/v1/payments/{paymentId}/status", paymentId)
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(objectMapper.writeValueAsString(request)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.data.status").value("CANCELLED"));
    }
}