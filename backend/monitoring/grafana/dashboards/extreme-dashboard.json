{
  "dashboard": {
    "id": null,
    "title": "🚀 Popcorn 극한 테스트 대시보드",
    "description": "5백만명 동시 접속 + 24시간 지속 테스트 모니터링",
    "tags": ["extreme", "load-test", "performance"],
    "timezone": "Asia/Seoul",
    "panels": [
      {
        "id": 1,
        "title": "🌊 동시 사용자 수",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(http_server_requests_seconds_count)",
            "legendFormat": "동시 요청"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 100000},
                {"color": "orange", "value": 1000000},
                {"color": "red", "value": 5000000}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "⚡ 응답 시간 (P95/P99)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "P95 응답시간"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "P99 응답시간"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s",
            "max": 10
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "🔥 요청 처리량 (RPS)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count[1m])",
            "legendFormat": "초당 요청 수"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-GrYlRd"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "❌ 오류율",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]) / rate(http_server_requests_seconds_count[5m]) * 100",
            "legendFormat": "5xx 오류율 (%)"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{status=~\"4..\"}[5m]) / rate(http_server_requests_seconds_count[5m]) * 100",
            "legendFormat": "4xx 오류율 (%)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "percent",
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "🧠 메모리 사용량",
        "type": "timeseries",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"} * 100",
            "legendFormat": "힙 메모리 사용률 (%)"
          },
          {
            "expr": "jvm_memory_used_bytes{area=\"nonheap\"} / 1024 / 1024",
            "legendFormat": "Non-Heap 메모리 (MB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "percent",
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 6,
        "title": "💻 CPU 사용률",
        "type": "gauge",
        "targets": [
          {
            "expr": "process_cpu_usage * 100",
            "legendFormat": "CPU 사용률"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "orange", "value": 80},
                {"color": "red", "value": 95}
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 24}
      },
      {
        "id": 7,
        "title": "🐒 Chaos Monkey 활동",
        "type": "stat",
        "targets": [
          {
            "expr": "chaos_monkey_assaults_total",
            "legendFormat": "총 공격 횟수"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "continuous-RdYlGr"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 24}
      },
      {
        "id": 8,
        "title": "💾 데이터베이스 커넥션",
        "type": "timeseries",
        "targets": [
          {
            "expr": "hikaricp_connections_active",
            "legendFormat": "활성 커넥션"
          },
          {
            "expr": "hikaricp_connections_max",
            "legendFormat": "최대 커넥션"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 9,
        "title": "🌐 네트워크 I/O",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(node_network_receive_bytes_total[5m]) * 8",
            "legendFormat": "수신 (bps)"
          },
          {
            "expr": "rate(node_network_transmit_bytes_total[5m]) * 8",
            "legendFormat": "송신 (bps)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "bps"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
      },
      {
        "id": 10,
        "title": "🏆 극한 테스트 성취",
        "type": "table",
        "targets": [
          {
            "expr": "up{job=\"popcorn-backend\"}",
            "legendFormat": "서버 상태",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Value"},
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {"type": "value", "value": "1", "text": "🟢 온라인"},
                    {"type": "value", "value": "0", "text": "🔴 오프라인"}
                  ]
                }
              ]
            }
          ]
        },
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 40}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s",
    "version": 1
  }
}