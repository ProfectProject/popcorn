package com.popcorn.order.controller;

import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.web.PageableDefault;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.popcorn.common.dto.BaseResponse;
import com.popcorn.order.dto.response.OrderResponseCode;
import com.popcorn.order.dto.event.OrderEventResponse;
import com.popcorn.order.dto.event.OrderEventSummary;
import com.popcorn.order.service.OrderEventService;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

/**
 * 주문 이벤트 관리 컨트롤러 - Event Sourcing & Event-Driven Architecture
 *
 * [Java 초보자를 위한 가이드]
 *
 * 이벤트 소싱(Event Sourcing)이란?
 * - 시스템에서 일어나는 모든 변경사항을 이벤트로 기록하는 패턴
 * - 데이터의 현재 상태가 아닌 변경 과정을 저장
 * - 언제든 과거의 이벤트들을 재생해서 특정 시점의 상태 복원 가능
 *
 * 왜 이벤트 소싱을 사용하나요?
 * 1. 감사 추적: 모든 변경 이력이 완벽하게 기록됨
 * 2. 디버깅: 문제가 생겼을 때 어떤 과정을 거쳤는지 정확히 추적 가능
 * 3. 분석: 사용자 행동 패턴, 비즈니스 인사이트 도출 가능
 * 4. 복구: 시스템 장애 시 특정 시점으로 되돌릴 수 있음
 *
 * MSA에서의 이벤트 활용:
 * - 마이크로서비스 간 느슨한 결합 유지
 * - 비동기 통신을 통한 성능 향상
 * - 각 서비스가 독립적으로 이벤트를 구독하고 처리
 *
 * 이 컨트롤러가 담당하는 일:
 * - 주문 관련 이벤트 조회 및 관리
 * - 이벤트 히스토리 추적
 * - 이벤트 재생(Replay) 기능
 * - 이벤트 메트릭 및 통계 제공
 * - 외부 시스템으로의 이벤트 전파 모니터링
 *
 * 사용된 Spring 어노테이션:
 * @RestController: REST API 컨트롤러임을 명시
 * @RequestMapping: 공통 URL 경로 설정 (/api/orders/v1/events)
 * @GetMapping: HTTP GET 요청 처리 (조회 작업)
 * @PostMapping: HTTP POST 요청 처리 (이벤트 재생 등)
 * @PathVariable: URL 경로의 변수 추출
 * @RequestParam: 쿼리 파라미터 추출
 * @DateTimeFormat: 날짜 형식 지정
 */
@RestController
@RequestMapping("/api/orders/v1/events")
@RequiredArgsConstructor
@Slf4j
@Tag(name = "Order Events", description = "주문 이벤트 관리 API (Event Sourcing)")
public class OrderEventController {

    /**
     * 의존성 주입
     * - OrderEventService: 이벤트 관련 비즈니스 로직 처리
     * - Event Sourcing 패턴의 핵심 서비스
     */
    private final OrderEventService orderEventService;

    /**
     * 특정 주문의 이벤트 히스토리 조회 API
     *
     * 사용 예시: GET /api/orders/v1/events/12345678-1234-1234-1234-123456789abc
     *
     * [Java 초보자를 위한 설명]
     * 하나의 주문이 생성되어 완료까지 거쳐간 모든 이벤트를 시간순으로 보여줍니다.
     * 예: 주문생성 → 결제완료 → 처리시작 → 배송시작 → 배송완료 → 주문완료
     *
     * 실무 활용:
     * - 고객 서비스팀이 주문 처리 과정을 확인할 때
     * - 문제가 생긴 주문의 원인을 분석할 때
     * - 주문 처리 시간을 측정하고 개선할 때
     */
    @GetMapping("/{orderId}")
    @Operation(
        summary = "주문 이벤트 히스토리 조회",
        description = """
            특정 주문의 모든 이벤트를 시간순으로 조회합니다.

            포함 정보:
            - 이벤트 타입 (ORDER_CREATED, PAYMENT_COMPLETED 등)
            - 발생 시간
            - 이벤트 상세 데이터
            - 이벤트 처리 상태
            - 관련 사용자 및 시스템 정보

            활용 사례:
            - 주문 추적 및 모니터링
            - 문제 발생 시 원인 분석
            - 고객 문의 대응
            - 시스템 성능 분석
            """
    )
    public ResponseEntity<BaseResponse<List<OrderEventResponse>>> getOrderEventHistory(
            @Parameter(description = "주문 ID", example = "12345678-1234-1234-1234-123456789abc")
            @PathVariable UUID orderId) {

        log.info("주문 이벤트 히스토리 조회 요청 - 주문ID: {}", orderId);

        try {
            // Event Store에서 해당 주문의 모든 이벤트 조회
            List<OrderEventResponse> events = orderEventService.getOrderEventHistory(orderId);

            log.info("이벤트 히스토리 조회 완료 - 주문ID: {}, 이벤트 개수: {}",
                    orderId, events.size());

            BaseResponse<List<OrderEventResponse>> baseResponse = BaseResponse.from(
                    OrderResponseCode.ORDER_EVENTS_RETRIEVED, events);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("이벤트 히스토리 조회 실패 - 주문ID: {}", orderId, e);

            BaseResponse<List<OrderEventResponse>> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 시스템 전체 이벤트 목록 조회 API (페이징 포함)
     *
     * 사용 예시: GET /api/orders/v1/events?page=0&size=50&sort=timestamp,desc&eventType=ORDER_CREATED
     *
     * [Java 초보자를 위한 설명]
     * 시스템에서 발생한 모든 주문 관련 이벤트를 조회합니다.
     * 관리자나 모니터링 시스템에서 전체 현황을 파악할 때 사용합니다.
     *
     * 실무 활용:
     * - 실시간 주문 모니터링 대시보드
     * - 시스템 상태 및 성능 분석
     * - 특정 기간의 주문 패턴 분석
     * - 장애 발생 시 영향 범위 파악
     */
    @GetMapping
    @Operation(
        summary = "시스템 이벤트 목록 조회",
        description = """
            시스템 전체의 주문 관련 이벤트를 조회합니다.

            필터링 옵션:
            - eventType: 특정 이벤트 타입만 조회
            - from/to: 특정 기간의 이벤트만 조회
            - userId: 특정 사용자의 이벤트만 조회
            - status: 이벤트 처리 상태별 조회

            정렬 옵션:
            - timestamp: 발생 시간순 정렬
            - eventType: 이벤트 타입별 정렬
            - orderId: 주문 ID별 정렬

            관리자 기능:
            - 실시간 이벤트 모니터링
            - 시스템 성능 분석
            - 장애 대응 및 원인 분석
            """
    )
    public ResponseEntity<BaseResponse<Page<OrderEventSummary>>> getSystemEvents(
            @Parameter(description = "이벤트 타입 필터")
            @RequestParam(required = false) String eventType,

            @Parameter(description = "사용자 ID 필터")
            @RequestParam(required = false) Long userId,

            @Parameter(description = "검색 시작 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime from,

            @Parameter(description = "검색 종료 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime to,

            @Parameter(description = "이벤트 처리 상태")
            @RequestParam(required = false) String status,

            @PageableDefault(size = 50, sort = "timestamp") Pageable pageable) {

        log.info("시스템 이벤트 목록 조회 - 타입: {}, 사용자: {}, 기간: {} ~ {}, 상태: {}",
                eventType, userId, from, to, status);

        try {
            // Event Store에서 조건에 맞는 이벤트들을 페이징하여 조회
            Page<OrderEventSummary> events = orderEventService.getSystemEvents(
                    eventType, userId, from, to, status, pageable);

            log.info("시스템 이벤트 조회 완료 - 조회된 이벤트: {}개, 전체: {}개",
                    events.getContent().size(), events.getTotalElements());

            BaseResponse<Page<OrderEventSummary>> baseResponse = BaseResponse.from(
                    OrderResponseCode.ORDER_EVENTS_RETRIEVED, events);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("시스템 이벤트 조회 실패 - 타입: {}, 사용자: {}", eventType, userId, e);

            BaseResponse<Page<OrderEventSummary>> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 이벤트 재생(Replay) API
     *
     * 사용 예시: POST /api/orders/v1/events/12345678-1234-1234-1234-123456789abc/replay
     *
     * [Java 초보자를 위한 설명]
     * Event Sourcing의 핵심 기능입니다.
     * 저장된 이벤트들을 순서대로 다시 재생해서 특정 시점의 주문 상태를 복원합니다.
     *
     * 언제 사용하나요?
     * 1. 데이터 손실이 발생했을 때 복구
     * 2. 새로운 View Model이나 Report를 생성할 때
     * 3. 시스템 마이그레이션 시 데이터 재구성
     * 4. 버그 수정 후 올바른 상태로 재계산
     *
     * 실무 활용:
     * - 시스템 장애 복구
     * - 데이터 재계산 및 검증
     * - 새로운 기능 개발 시 과거 데이터 적용
     */
    @PostMapping("/{orderId}/replay")
    @Operation(
        summary = "주문 이벤트 재생",
        description = """
            특정 주문의 이벤트를 재생하여 상태를 복원합니다.

            재생 과정:
            1. 해당 주문의 모든 이벤트를 시간순으로 조회
            2. 각 이벤트를 순서대로 재처리
            3. 주문 상태를 올바르게 복원
            4. 연관된 다른 서비스에 이벤트 전파

            주의사항:
            - 재생 중에는 해당 주문을 수정할 수 없음
            - 대량의 이벤트가 있는 경우 시간이 오래 걸림
            - 관리자 권한이 필요한 작업

            사용 사례:
            - 시스템 오류로 인한 데이터 복구
            - 로직 변경 후 기존 데이터 재계산
            - 감사 요청 시 특정 시점 상태 재현
            """
    )
    public ResponseEntity<BaseResponse<String>> replayOrderEvents(
            @Parameter(description = "주문 ID", example = "12345678-1234-1234-1234-123456789abc")
            @PathVariable UUID orderId,

            @Parameter(description = "재생할 종료 시점 (선택적)")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime upTo) {

        log.info("주문 이벤트 재생 요청 - 주문ID: {}, 종료시점: {}", orderId, upTo);

        try {
            // Event Sourcing: 이벤트 재생으로 상태 복원
            String replayId = orderEventService.replayOrderEvents(orderId, upTo);

            log.info("이벤트 재생 시작 완료 - 주문ID: {}, 재생ID: {}", orderId, replayId);

            // 재생은 비동기로 처리되므로 재생 ID만 반환
            BaseResponse<String> baseResponse = BaseResponse.from(
                    OrderResponseCode.EVENT_REPLAY_STARTED, replayId);

            return ResponseEntity.ok(baseResponse);

        } catch (IllegalArgumentException e) {
            log.error("이벤트 재생 실패 - 잘못된 요청: {}", e.getMessage());

            BaseResponse<String> errorResponse = BaseResponse.from(
                    OrderResponseCode.INVALID_ORDER_REQUEST, null);

            return ResponseEntity.status(OrderResponseCode.INVALID_ORDER_REQUEST.getHttpStatus())
                    .body(errorResponse);

        } catch (Exception e) {
            log.error("이벤트 재생 실패 - 주문ID: {}", orderId, e);

            BaseResponse<String> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 이벤트 메트릭 및 통계 조회 API
     *
     * 사용 예시: GET /api/orders/v1/events/metrics?from=2024-01-01T00:00:00&to=2024-01-31T23:59:59
     *
     * [Java 초보자를 위한 설명]
     * 이벤트 발생 현황을 통계로 보여주는 API입니다.
     * 비즈니스 인사이트 도출과 시스템 모니터링에 활용됩니다.
     *
     * 제공하는 메트릭:
     * - 시간대별 이벤트 발생 빈도
     * - 이벤트 타입별 분포
     * - 평균 처리 시간
     * - 실패율 및 성공률
     *
     * 실무 활용:
     * - 주문 패턴 분석 (시간대별, 요일별)
     * - 시스템 성능 모니터링
     * - 비즈니스 KPI 측정
     * - 용량 계획 수립
     */
    @GetMapping("/metrics")
    @Operation(
        summary = "이벤트 메트릭 조회",
        description = """
            주문 관련 이벤트의 통계 및 메트릭을 조회합니다.

            제공 메트릭:
            - 총 이벤트 발생 수
            - 이벤트 타입별 분포
            - 시간대별 발생 빈도
            - 평균/최대/최소 처리 시간
            - 성공률 및 실패율
            - 사용자별 이벤트 통계

            분석 차원:
            - 시간별 분석 (시간, 일, 주, 월)
            - 이벤트 타입별 분석
            - 사용자 행동 패턴 분석
            - 시스템 성능 분석

            비즈니스 활용:
            - 주문 패턴 파악
            - 피크 시간대 식별
            - 고객 행동 분석
            - 시스템 최적화 포인트 발굴
            """
    )
    public ResponseEntity<BaseResponse<Object>> getEventMetrics(
            @Parameter(description = "통계 시작 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime from,

            @Parameter(description = "통계 종료 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime to,

            @Parameter(description = "집계 단위 (HOUR, DAY, WEEK, MONTH)")
            @RequestParam(required = false, defaultValue = "DAY") String aggregateBy) {

        log.info("이벤트 메트릭 조회 요청 - 기간: {} ~ {}, 집계단위: {}", from, to, aggregateBy);

        try {
            // Event Store에서 메트릭 데이터 계산 및 집계
            Object metrics = orderEventService.getEventMetrics(from, to, aggregateBy);

            log.info("이벤트 메트릭 조회 완료 - 기간: {} ~ {}", from, to);

            BaseResponse<Object> baseResponse = BaseResponse.from(
                    OrderResponseCode.ORDER_EVENTS_RETRIEVED, metrics);

            return ResponseEntity.ok(baseResponse);

        } catch (IllegalArgumentException e) {
            log.error("이벤트 메트릭 조회 실패 - 잘못된 파라미터: {}", e.getMessage());

            BaseResponse<Object> errorResponse = BaseResponse.from(
                    OrderResponseCode.INVALID_ORDER_REQUEST, null);

            return ResponseEntity.status(OrderResponseCode.INVALID_ORDER_REQUEST.getHttpStatus())
                    .body(errorResponse);

        } catch (Exception e) {
            log.error("이벤트 메트릭 조회 실패 - 기간: {} ~ {}", from, to, e);

            BaseResponse<Object> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

}