package com.popcorn.order.controller;

import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.web.PageableDefault;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.popcorn.common.dto.BaseResponse;
import com.popcorn.order.dto.response.OrderResponseCode;
import com.popcorn.order.dto.idempotency.IdempotencyKeyResponse;
import com.popcorn.order.dto.idempotency.IdempotencyStatistics;
import com.popcorn.order.service.OrderIdempotencyService;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.Parameter;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

/**
 * 주문 멱등성 관리 컨트롤러
 *
 * 멱등성(Idempotency)이란?
 * - 같은 요청을 여러 번 보내도 결과가 동일하게 보장되는 성질
 * - 네트워크 불안정, 사용자 실수로 인한 중복 요청을 방지
 * - 분산 시스템에서 매우 중요한 개념
 *
 * 왜 멱등성이 필요한가요?
 * 1. 사용자가 결제 버튼을 여러 번 클릭하는 경우
 * 2. 네트워크 타임아웃으로 클라이언트가 재시도하는 경우
 * 3. 마이크로서비스 간 통신에서 재시도 로직
 * 4. 모바일 앱에서 네트워크 불안정으로 중복 요청
 *
 * 멱등성 키(Idempotency Key) 작동 원리:
 * 1. 클라이언트가 고유한 키와 함께 요청 전송
 * 2. 서버가 해당 키로 이전 요청 이력 확인
 * 3. 이미 처리된 요청이면 저장된 응답 반환
 * 4. 새로운 요청이면 정상 처리 후 결과 저장
 *
 * 실무에서의 활용:
 * - 결제 시스템: 중복 결제 방지
 * - 주문 시스템: 중복 주문 방지
 * - 메시지 전송: 중복 발송 방지
 * - API 게이트웨이: 전체 시스템 레벨에서 중복 요청 차단
 */
@RestController
@RequestMapping("/api/orders/v1/idempotency")
@RequiredArgsConstructor
@Slf4j
@Tag(name = "Order Idempotency", description = "주문 멱등성 관리 API")
public class OrderIdempotencyController {

    private final OrderIdempotencyService idempotencyService;

    /**
     * 멱등성 키 생성 API
     *
     * 사용 예시: POST /api/orders/v1/idempotency/keys
     *
     * 클라이언트가 요청 전에 미리 멱등성 키를 발급받아서
     * 실제 주문 요청 시 함께 전송하는 패턴입니다.
     * 이 방식은 키 충돌을 방지하고 중복 요청 추적을 더 정확히 할 수 있습니다.
     */
    @PostMapping("/keys")
    @Operation(
        summary = "멱등성 키 생성",
        description = """
            새로운 멱등성 키를 생성합니다.

            생성되는 키의 특성:
            - UUID 기반의 전역 고유 식별자
            - 24시간 유효기간 (설정 가능)
            - 암호학적으로 안전한 난수 사용

            사용 패턴:
            1. 클라이언트가 주문 요청 전에 키 발급
            2. 발급받은 키를 헤더에 포함하여 주문 요청
            3. 서버는 키를 통해 중복 요청 여부 판단

            장점:
            - 키 충돌 완전 방지
            - 요청 추적이 명확함
            - 디버깅과 모니터링 용이
            """
    )
    public ResponseEntity<BaseResponse<IdempotencyKeyResponse>> generateIdempotencyKey() {

        log.info("멱등성 키 생성 요청");

        try {
            IdempotencyKeyResponse response = idempotencyService.generateKey();

            log.info("멱등성 키 생성 완료 - 키: {}, 만료시간: {}",
                    response.getKey(), response.getExpiresAt());

            BaseResponse<IdempotencyKeyResponse> baseResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_KEY_GENERATED, response);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("멱등성 키 생성 실패", e);

            BaseResponse<IdempotencyKeyResponse> errorResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_KEY_GENERATION_FAILED, null);

            return ResponseEntity.status(OrderResponseCode.IDEMPOTENCY_KEY_GENERATION_FAILED.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 멱등성 키 상태 조회 API
     *
     * 사용 예시: GET /api/orders/v1/idempotency/keys/idem-12345678-1234-1234-1234-123456789abc
     *
     * 특정 멱등성 키가 어떻게 사용되었는지 상태를 확인합니다.
     * 디버깅이나 고객 지원 시에 유용한 API입니다.
     */
    @GetMapping("/keys/{idempotencyKey}")
    @Operation(
        summary = "멱등성 키 상태 조회",
        description = """
            특정 멱등성 키의 사용 이력과 상태를 조회합니다.

            조회 가능한 정보:
            - 키 생성 시간과 만료 시간
            - 사용 여부와 사용 시간
            - 연결된 주문 정보
            - 요청 횟수와 응답 정보

            상태 종류:
            - GENERATED: 생성됨 (아직 사용 안 됨)
            - USED: 사용됨 (정상 처리 완료)
            - EXPIRED: 만료됨
            - FAILED: 처리 실패

            활용 사례:
            - 고객 문의 시 주문 상태 확인
            - 중복 요청 이슈 디버깅
            - 시스템 모니터링
            """
    )
    public ResponseEntity<BaseResponse<IdempotencyKeyResponse>> getIdempotencyKeyStatus(
            @Parameter(description = "조회할 멱등성 키", example = "idem-12345678-1234-1234-1234-123456789abc")
            @PathVariable String idempotencyKey) {

        log.info("멱등성 키 상태 조회 요청 - 키: {}", idempotencyKey);

        try {
            IdempotencyKeyResponse response = idempotencyService.getKeyStatus(idempotencyKey);

            if (response == null) {
                log.warn("멱등성 키를 찾을 수 없음 - 키: {}", idempotencyKey);

                BaseResponse<IdempotencyKeyResponse> notFoundResponse = BaseResponse.from(
                        OrderResponseCode.IDEMPOTENCY_KEY_NOT_FOUND, null);

                return ResponseEntity.status(OrderResponseCode.IDEMPOTENCY_KEY_NOT_FOUND.getHttpStatus())
                        .body(notFoundResponse);
            }

            log.info("멱등성 키 상태 조회 완료 - 키: {}, 상태: {}",
                    idempotencyKey, response.getStatus());

            BaseResponse<IdempotencyKeyResponse> baseResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_KEY_STATUS_RETRIEVED, response);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("멱등성 키 상태 조회 실패 - 키: {}", idempotencyKey, e);

            BaseResponse<IdempotencyKeyResponse> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 사용자별 멱등성 키 목록 조회 API
     *
     * 사용 예시: GET /api/orders/v1/idempotency/users/123/keys?page=0&size=20
     *
     * 특정 사용자가 생성한 모든 멱등성 키의 이력을 조회합니다.
     * 사용자의 요청 패턴 분석이나 문제 해결에 활용됩니다.
     */
    @GetMapping("/users/{userId}/keys")
    @Operation(
        summary = "사용자별 멱등성 키 목록 조회",
        description = """
            특정 사용자가 사용한 멱등성 키 목록을 조회합니다.

            조회 기간을 지정할 수 있고, 페이징을 지원합니다.

            분석 가능한 정보:
            - 사용자의 중복 요청 패턴
            - 네트워크 불안정으로 인한 재시도 빈도
            - 주문 완료율과 실패율
            - 시간대별 요청 분포

            고객 지원 활용:
            - "주문이 안 되네요" 문의 시 확인
            - 중복 결제 문의 시 원인 파악
            - 시스템 이슈 영향 범위 확인
            """
    )
    public ResponseEntity<BaseResponse<Page<IdempotencyKeyResponse>>> getUserIdempotencyKeys(
            @Parameter(description = "사용자 ID", example = "123")
            @PathVariable Long userId,

            @Parameter(description = "조회 시작 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime from,

            @Parameter(description = "조회 종료 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime to,

            @PageableDefault(size = 20, sort = "createdAt") Pageable pageable) {

        log.info("사용자별 멱등성 키 목록 조회 - 사용자: {}, 기간: {} ~ {}",
                userId, from, to);

        try {
            Page<IdempotencyKeyResponse> keys = idempotencyService.getUserKeys(
                    userId, from, to, pageable);

            log.info("사용자별 멱등성 키 조회 완료 - 사용자: {}, 조회된 키: {}개",
                    userId, keys.getContent().size());

            BaseResponse<Page<IdempotencyKeyResponse>> baseResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_KEYS_RETRIEVED, keys);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("사용자별 멱등성 키 조회 실패 - 사용자: {}", userId, e);

            BaseResponse<Page<IdempotencyKeyResponse>> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 중복 요청 차단 이력 조회 API
     *
     * 사용 예시: GET /api/orders/v1/idempotency/blocked-requests?from=2024-03-01T00:00:00
     *
     * 멱등성 시스템에 의해 차단된 중복 요청들의 이력을 조회합니다.
     * 시스템 효과성 측정과 모니터링에 활용됩니다.
     */
    @GetMapping("/blocked-requests")
    @Operation(
        summary = "중복 요청 차단 이력 조회",
        description = """
            멱등성 시스템에 의해 차단된 중복 요청 이력을 조회합니다.

            차단된 요청의 정보:
            - 원본 요청 시간과 중복 요청 시간
            - 사용자 정보와 요청 내용
            - 차단된 이유와 반환된 응답
            - 요청 간 시간 간격

            모니터링 지표:
            - 중복 요청 차단률
            - 시간대별 중복 요청 패턴
            - 사용자별 중복 요청 빈도
            - 네트워크 이슈 감지

            시스템 개선 활용:
            - UX 개선 포인트 발굴
            - 클라이언트 재시도 로직 최적화
            - 네트워크 안정성 모니터링
            """
    )
    public ResponseEntity<BaseResponse<Page<IdempotencyKeyResponse>>> getBlockedRequests(
            @Parameter(description = "조회 시작 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime from,

            @Parameter(description = "조회 종료 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime to,

            @Parameter(description = "사용자 ID 필터")
            @RequestParam(required = false) Long userId,

            @PageableDefault(size = 50, sort = "blockedAt") Pageable pageable) {

        log.info("중복 요청 차단 이력 조회 - 기간: {} ~ {}, 사용자: {}",
                from, to, userId);

        try {
            Page<IdempotencyKeyResponse> blockedRequests = idempotencyService.getBlockedRequests(
                    from, to, userId, pageable);

            log.info("중복 요청 차단 이력 조회 완료 - 조회된 건수: {}개",
                    blockedRequests.getContent().size());

            BaseResponse<Page<IdempotencyKeyResponse>> baseResponse = BaseResponse.from(
                    OrderResponseCode.BLOCKED_REQUESTS_RETRIEVED, blockedRequests);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("중복 요청 차단 이력 조회 실패 - 기간: {} ~ {}", from, to, e);

            BaseResponse<Page<IdempotencyKeyResponse>> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 멱등성 시스템 통계 조회 API
     *
     * 사용 예시: GET /api/orders/v1/idempotency/statistics?period=DAILY
     *
     * 멱등성 시스템의 전반적인 효과와 성능을 측정하는 통계를 제공합니다.
     * 관리자 대시보드나 시스템 모니터링에 활용됩니다.
     */
    @GetMapping("/statistics")
    @Operation(
        summary = "멱등성 시스템 통계",
        description = """
            멱등성 시스템의 운영 통계를 제공합니다.

            제공하는 통계:
            - 총 생성된 키 수
            - 사용된 키 수와 사용률
            - 중복 요청 차단 수와 차단률
            - 평균 키 사용 시간
            - 만료된 키 수

            기간별 분석:
            - HOURLY: 시간별 통계
            - DAILY: 일별 통계
            - WEEKLY: 주별 통계
            - MONTHLY: 월별 통계

            성능 지표:
            - 시스템 효율성 측정
            - 중복 요청 방지 효과
            - 사용자 경험 개선 지표
            - 시스템 안정성 평가
            """
    )
    public ResponseEntity<BaseResponse<IdempotencyStatistics>> getIdempotencyStatistics(
            @Parameter(description = "통계 기간 (HOURLY, DAILY, WEEKLY, MONTHLY)")
            @RequestParam(required = false, defaultValue = "DAILY") String period,

            @Parameter(description = "통계 시작 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime from,

            @Parameter(description = "통계 종료 날짜")
            @RequestParam(required = false)
            @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME) LocalDateTime to) {

        log.info("멱등성 시스템 통계 조회 - 기간: {}, 범위: {} ~ {}", period, from, to);

        try {
            IdempotencyStatistics statistics = idempotencyService.getStatistics(period, from, to);

            log.info("멱등성 통계 조회 완료 - 생성된키: {}, 사용된키: {}, 차단된요청: {}",
                    statistics.getTotalKeysGenerated(),
                    statistics.getTotalKeysUsed(),
                    statistics.getTotalRequestsBlocked());

            BaseResponse<IdempotencyStatistics> baseResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_STATISTICS_RETRIEVED, statistics);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("멱등성 통계 조회 실패 - 기간: {}", period, e);

            BaseResponse<IdempotencyStatistics> errorResponse = BaseResponse.from(
                    OrderResponseCode.DATABASE_ERROR, null);

            return ResponseEntity.status(OrderResponseCode.DATABASE_ERROR.getHttpStatus())
                    .body(errorResponse);
        }
    }

    /**
     * 만료된 멱등성 키 정리 API
     *
     * 사용 예시: DELETE /api/orders/v1/idempotency/cleanup?olderThanHours=72
     *
     * 만료된 멱등성 키들을 데이터베이스에서 제거하여
     * 스토리지 공간을 절약하고 성능을 최적화합니다.
     * 일반적으로 스케줄러가 주기적으로 호출하지만
     * 필요시 수동으로도 실행할 수 있습니다.
     */
    @DeleteMapping("/cleanup")
    @Operation(
        summary = "만료된 멱등성 키 정리",
        description = """
            만료된 멱등성 키를 데이터베이스에서 정리합니다.

            정리 대상:
            - 설정된 시간보다 오래된 만료 키
            - 사용되지 않은 채 만료된 키
            - 에러 상태로 남아있는 키

            정리 효과:
            - 데이터베이스 용량 절약
            - 쿼리 성능 향상
            - 시스템 리소스 최적화

            주의사항:
            - 관리자 권한 필요
            - 정리된 키는 복구 불가
            - 통계 데이터는 별도 보관
            """
    )
    public ResponseEntity<BaseResponse<Integer>> cleanupExpiredKeys(
            @Parameter(description = "정리 대상 시간 (시간 단위)", example = "72")
            @RequestParam(required = false, defaultValue = "72") int olderThanHours) {

        log.info("만료된 멱등성 키 정리 시작 - 기준시간: {}시간 전", olderThanHours);

        try {
            int cleanedCount = idempotencyService.cleanupExpiredKeys(olderThanHours);

            log.info("만료된 멱등성 키 정리 완료 - 정리된 키: {}개", cleanedCount);

            BaseResponse<Integer> baseResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_CLEANUP_COMPLETED, cleanedCount);

            return ResponseEntity.ok(baseResponse);

        } catch (Exception e) {
            log.error("멱등성 키 정리 실패", e);

            BaseResponse<Integer> errorResponse = BaseResponse.from(
                    OrderResponseCode.IDEMPOTENCY_CLEANUP_FAILED, null);

            return ResponseEntity.status(OrderResponseCode.IDEMPOTENCY_CLEANUP_FAILED.getHttpStatus())
                    .body(errorResponse);
        }
    }

}