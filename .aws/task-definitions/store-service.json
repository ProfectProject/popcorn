{
  "family": "goorm-popcorn-${ENVIRONMENT}-store-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "store-service",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-store:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "DB_HOST",
          "value": "${DB_HOST}"
        },
        {
          "name": "DB_PORT",
          "value": "${DB_PORT}"
        },
        {
          "name": "DB_NAME",
          "value": "${DB_NAME}"
        },
        {
          "name": "STORE_DB_USERNAME",
          "value": "store_app"
        },
        {
          "name": "STORE_DB_PASSWORD",
          "value": "store123"
        },
        {
          "name": "STORE_FLYWAY_USERNAME",
          "value": "store_migrator"
        },
        {
          "name": "STORE_FLYWAY_PASSWORD",
          "value": "store321"
        },
        {
          "name": "JWT_SECRET",
          "value": "bXlWZXJ5TG9uZ1NlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvblRoYXRJczI1NkJpdHNMb25nMTIzNDU="
        },
        {
          "name": "PASSPORT_SECRET",
          "value": "passport-shared-secret"
        },
        {
          "name": "GATEWAY_URL",
          "value": "https://dev.goormpopcorn.shop"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/store-service",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 30,
      "startTimeout": 120,
      "mountPoints": [
        {
          "sourceVolume": "tmp-uploads",
          "containerPath": "/tmp/uploads",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "tmp-uploads",
      "host": {}
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "store-service"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    }
  ]
}
