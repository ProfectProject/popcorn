{
  "family": "goorm-popcorn-${ENVIRONMENT}-payment-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "payment-service",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-payment:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE",
          "value": "health,info,metrics"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS",
          "value": "always"
        },
        {
          "name": "LOGGING_LEVEL_COM_GOORMPOPCORN",
          "value": "INFO"
        },
        {
          "name": "LOGGING_LEVEL_ROOT",
          "value": "WARN"
        },
        {
          "name": "SPRING_CLOUD_AWS_REGION_STATIC",
          "value": "ap-northeast-2"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "${DB_USER}"
        },
        {
          "name": "SPRING_DATASOURCE_DRIVER_CLASS_NAME",
          "value": "org.postgresql.Driver"
        },
        {
          "name": "SPRING_JPA_DATABASE_PLATFORM",
          "value": "org.hibernate.dialect.PostgreSQLDialect"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "validate"
        },
        {
          "name": "SPRING_JPA_SHOW_SQL",
          "value": "false"
        },
        {
          "name": "REDIS_HOST",
          "value": "${REDIS_PRIMARY_ENDPOINT}"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "${KAFKA_BOOTSTRAP_SERVERS}"
        },
        {
          "name": "KAFKA_CONSUMER_GROUP_ID",
          "value": "payment-service-group"
        },
        {
          "name": "KAFKA_PRODUCER_RETRIES",
          "value": "5"
        },
        {
          "name": "KAFKA_PRODUCER_ACKS",
          "value": "all"
        },
        {
          "name": "KAFKA_PRODUCER_ENABLE_IDEMPOTENCE",
          "value": "true"
        },
        {
          "name": "ORDER_SERVICE_URL",
          "value": "http://order-service.goormpopcorn.local:8084"
        },
        {
          "name": "PAYMENT_GATEWAY_URL",
          "value": "https://api.tosspayments.com"
        },
        {
          "name": "PAYMENT_TIMEOUT_SECONDS",
          "value": "30"
        },
        {
          "name": "PAYMENT_RETRY_MAX_ATTEMPTS",
          "value": "3"
        },
        {
          "name": "ENCRYPTION_ALGORITHM",
          "value": "AES/GCM/NoPadding"
        },
        {
          "name": "JWT_SECRET",
          "value": "bXlWZXJ5TG9uZ1NlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvblRoYXRJczI1NkJpdHNMb25nMTIzNDU="
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "name": "PASSPORT_SECRET",
          "value": "passport-shared-secret"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "value": "goorm-popcorn-cache-dev.mkltth.ng.0001.apn2.cache.amazonaws.com"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        }
      ],
      "secrets": [
        {
          "name": "TOSS_PAYMENTS_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:${AWS_ACCOUNT_ID}:secret:goorm-popcorn-${ENVIRONMENT}/payment/toss-secret"
        },
        {
          "name": "PAYMENT_ENCRYPTION_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:${AWS_ACCOUNT_ID}:secret:goorm-popcorn-${ENVIRONMENT}/payment/encryption-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/payment-service",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 5,
        "startPeriod": 120
      },
      "stopTimeout": 60,
      "startTimeout": 180
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "payment-service"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    },
    {
      "key": "SecurityLevel",
      "value": "high"
    }
  ]
}
