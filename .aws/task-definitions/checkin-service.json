{
  "family": "goorm-popcorn-${ENVIRONMENT}-checkin-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "checkin-service",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-checkin:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "DB_HOST",
          "value": "${DB_HOST}"
        },
        {
          "name": "DB_PORT",
          "value": "${DB_PORT}"
        },
        {
          "name": "DB_NAME",
          "value": "${DB_NAME}"
        },
        {
          "name": "QR_DB_USERNAME",
          "value": "${QR_DB_USERNAME}"
        },
        {
          "name": "QR_DB_PASSWORD",
          "value": "${QR_DB_PASSWORD}"
        },
        {
          "name": "QR_FLYWAY_PASSWORD",
          "value": "${QR_FLYWAY_PASSWORD}"
        },
        {
          "name": "JWT_SECRET",
          "value": "${JWT_SECRET}"
        },
        {
          "name": "PASSPORT_SECRET",
          "value": "${PASSPORT_SECRET}"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "value": "${REDIS_PRIMARY_ENDPOINT}"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "GATEWAY_URL",
          "value": "${GATEWAY_URL}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/checkin-service",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 30,
      "startTimeout": 120
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "checkin-service"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    }
  ]
}
