{
  "family": "goorm-popcorn-${ENVIRONMENT}-qr-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "qr-service",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-qr:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE",
          "value": "health,info,metrics"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS",
          "value": "always"
        },
        {
          "name": "LOGGING_LEVEL_COM_GOORMPOPCORN",
          "value": "DEBUG"
        },
        {
          "name": "LOGGING_LEVEL_ROOT",
          "value": "INFO"
        },
        {
          "name": "SPRING_CLOUD_AWS_REGION_STATIC",
          "value": "ap-northeast-2"
        },
        {
          "name": "REDIS_HOST",
          "value": "${REDIS_PRIMARY_ENDPOINT}"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "REDIS_TIMEOUT",
          "value": "2000"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "${KAFKA_BOOTSTRAP_SERVERS}"
        },
        {
          "name": "KAFKA_CONSUMER_GROUP_ID",
          "value": "qr-service-group"
        },
        {
          "name": "ORDER_SERVICE_URL",
          "value": "http://order-service.goormpopcorn.local:8080"
        },
        {
          "name": "STORE_SERVICE_URL",
          "value": "http://store-service.goormpopcorn.local:8080"
        },
        {
          "name": "QR_CODE_SIZE",
          "value": "300"
        },
        {
          "name": "QR_CODE_FORMAT",
          "value": "PNG"
        },
        {
          "name": "QR_CODE_EXPIRY_MINUTES",
          "value": "60"
        },
        {
          "name": "QR_CODE_BASE_URL",
          "value": "https://${ENVIRONMENT}.goormpopcorn.shop/qr"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "goorm-popcorn-${ENVIRONMENT}-qr-codes"
        },
        {
          "name": "S3_QR_PREFIX",
          "value": "qr-codes/"
        }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/qr-service",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 45
      },
      "stopTimeout": 30,
      "startTimeout": 90
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "qr-service"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    }
  ]
}