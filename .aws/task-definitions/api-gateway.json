{
  "family": "goorm-popcorn-${ENVIRONMENT}-api-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-api-gateway:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "CHECKIN_SERVICE_URL",
          "value": "http://checkin-service.goormpopcorn.local:8086"
        },
        {
          "name": "BACKEND_SERVICE_URL",
          "value": "http://backend-service.goormpopcorn.local:8081"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://user-service.goormpopcorn.local:8082"
        },
        {
          "name": "STORE_SERVICE_URL",
          "value": "http://store-service.goormpopcorn.local:8083"
        },
        {
          "name": "ORDER_SERVICE_URL",
          "value": "http://order-service.goormpopcorn.local:8084"
        },
        {
          "name": "PAYMENT_SERVICE_URL",
          "value": "http://payment-service.goormpopcorn.local:8085"
        },
        {
          "name": "ORDERQUERY_SERVICE_URL",
          "value": "http://order-query.goormpopcorn.local:8087"
        },
        {
          "name": "GATEWAY_SERVICE_URL",
          "value": "https://dev.goormpopcorn.shop"
        },
        {
          "name": "JWT_SECRET",
          "value": "bXlWZXJ5TG9uZ1NlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvblRoYXRJczI1NkJpdHNMb25nMTIzNDU="
        },
        {
          "name": "PASSPORT_SECRET",
          "value": "passport-shared-secret"
        },
        {
          "name": "SPRING_DATA_REDIS_HOST",
          "value": "${REDIS_PRIMARY_ENDPOINT}"
        },
        {
          "name": "SPRING_DATA_REDIS_PORT",
          "value": "6379"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/api-gateway",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "stopTimeout": 30,
      "startTimeout": 120
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "api-gateway"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    }
  ]
}