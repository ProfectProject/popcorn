{
  "family": "goorm-popcorn-${ENVIRONMENT}-api-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/goorm-popcorn-${ENVIRONMENT}-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.ap-northeast-2.amazonaws.com/goorm-popcorn-api-gateway:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE",
          "value": "health,info,metrics,prometheus"
        },
        {
          "name": "MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS",
          "value": "always"
        },
        {
          "name": "LOGGING_LEVEL_COM_GOORMPOPCORN",
          "value": "DEBUG"
        },
        {
          "name": "LOGGING_LEVEL_ROOT",
          "value": "INFO"
        },
        {
          "name": "EUREKA_CLIENT_ENABLED",
          "value": "false"
        },
        {
          "name": "SPRING_CLOUD_DISCOVERY_ENABLED",
          "value": "true"
        },
        {
          "name": "SPRING_CLOUD_AWS_REGION_STATIC",
          "value": "ap-northeast-2"
        },
        {
          "name": "SERVICE_DISCOVERY_NAMESPACE",
          "value": "goormpopcorn.local"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://localhost:8082"
        },
        {
          "name": "STORE_SERVICE_URL",
          "value": "http://localhost:8083"
        },
        {
          "name": "ORDER_SERVICE_URL",
          "value": "http://localhost:8084"
        },
        {
          "name": "PAYMENT_SERVICE_URL",
          "value": "http://localhost:8085"
        },
        {
          "name": "ORDER_QUERY_SERVICE_URL",
          "value": "http://order-query.goormpopcorn.local:8087"
        },
        {
          "name": "REDIS_HOST",
          "value": "${REDIS_PRIMARY_ENDPOINT}"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "${KAFKA_BOOTSTRAP_SERVERS}"
        },
        {
          "name": "JWT_SECRET",
          "value": "bXlWZXJ5TG9uZ1NlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvblRoYXRJczI1NkJpdHNMb25nMTIzNDU="
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "name": "PASSPORT_SECRET",
          "value": "passport-shared-secret"
        },
        {
          "name": "CHECKIN_SERVICE_URL",
          "value": "http://localhost:8086"
        },
        {
          "name": "GATEWAY_SERVICE_URL",
          "value": "http://localhost:8080"
        },
        {
          "name": "ORDERQUERY_SERVICE_URL",
          "value": "http://localhost:8087"
        },
        {
          "name": "BACKEND_SERVICE_URL",
          "value": "http://localhost:8081"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "http://localhost:3000,http://127.0.0.1:3000"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/goorm-popcorn-${ENVIRONMENT}/api-gateway",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/actuator/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "stopTimeout": 30,
      "startTimeout": 120
    }
  ],
  "tags": [
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "Service",
      "value": "api-gateway"
    },
    {
      "key": "Project",
      "value": "goorm-popcorn"
    },
    {
      "key": "ManagedBy",
      "value": "application-team"
    }
  ]
}
