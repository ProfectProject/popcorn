# Dev 환경 설정
ENVIRONMENT=dev
AWS_ACCOUNT_ID=375896310755
AWS_REGION=ap-northeast-2

# 기본 이미지 태그
DEFAULT_IMAGE_TAG=dev-latest

# ECS 클러스터 정보
ECS_CLUSTER_NAME=goorm-popcorn-dev-cluster

# 서비스 리소스 설정 (CPU/Memory)
API_GATEWAY_CPU=512
API_GATEWAY_MEMORY=1024

USER_SERVICE_CPU=256
USER_SERVICE_MEMORY=512

STORE_SERVICE_CPU=256
STORE_SERVICE_MEMORY=512

ORDER_SERVICE_CPU=512
ORDER_SERVICE_MEMORY=1024

PAYMENT_SERVICE_CPU=512
PAYMENT_SERVICE_MEMORY=1024

QR_SERVICE_CPU=256
QR_SERVICE_MEMORY=512

ORDER_QUERY_CPU=256
ORDER_QUERY_MEMORY=512

# 로깅 설정
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_RETENTION_DAYS=7

# 도메인 설정
BASE_DOMAIN=dev.goormpopcorn.shop
SERVICE_DISCOVERY_NAMESPACE=goormpopcorn.local

# S3 버킷 설정
ASSETS_BUCKET=goorm-popcorn-dev-assets
QR_CODES_BUCKET=goorm-popcorn-dev-qr-codes

# JWT 설정 (개발용)
JWT_SECRET_KEY=goorm-popcorn-jwt-secret-key-for-dev-environment
JWT_EXPIRATION_TIME=86400000

# 결제 게이트웨이
PAYMENT_GATEWAY_URL=https://api.tosspayments.com
PAYMENT_TIMEOUT_SECONDS=30

# QR 코드 설정
QR_CODE_SIZE=300
QR_CODE_FORMAT=PNG
QR_CODE_EXPIRY_MINUTES=60

# 주문 설정
ORDER_TIMEOUT_MINUTES=30
SAGA_TIMEOUT_MINUTES=5

# 캐시 설정
REDIS_TIMEOUT=2000
REDIS_CACHE_TTL_SECONDS=300

# 페이징 설정
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100