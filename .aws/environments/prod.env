# Prod 환경 설정
ENVIRONMENT=prod
AWS_ACCOUNT_ID=375896310755
AWS_REGION=ap-northeast-2

# 기본 이미지 태그
DEFAULT_IMAGE_TAG=latest

# ECS 클러스터 정보
ECS_CLUSTER_NAME=goorm-popcorn-prod-cluster

# 서비스 리소스 설정 (CPU/Memory) - 프로덕션 최적화
API_GATEWAY_CPU=1024
API_GATEWAY_MEMORY=2048

USER_SERVICE_CPU=512
USER_SERVICE_MEMORY=1024

STORE_SERVICE_CPU=512
STORE_SERVICE_MEMORY=1024

ORDER_SERVICE_CPU=1024
ORDER_SERVICE_MEMORY=2048

PAYMENT_SERVICE_CPU=1024
PAYMENT_SERVICE_MEMORY=2048

QR_SERVICE_CPU=256
QR_SERVICE_MEMORY=512

ORDER_QUERY_CPU=512
ORDER_QUERY_MEMORY=1024

# 로깅 설정 (프로덕션 최적화)
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_RETENTION_DAYS=30

# 도메인 설정
BASE_DOMAIN=goormpopcorn.shop
SERVICE_DISCOVERY_NAMESPACE=goormpopcorn.local

# S3 버킷 설정
ASSETS_BUCKET=goorm-popcorn-prod-assets
QR_CODES_BUCKET=goorm-popcorn-prod-qr-codes

# JWT 설정 (프로덕션용 - 실제로는 Secrets Manager 사용)
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRATION_TIME=3600000

# 결제 게이트웨이
PAYMENT_GATEWAY_URL=https://api.tosspayments.com
PAYMENT_TIMEOUT_SECONDS=30

# QR 코드 설정
QR_CODE_SIZE=300
QR_CODE_FORMAT=PNG
QR_CODE_EXPIRY_MINUTES=60

# 주문 설정
ORDER_TIMEOUT_MINUTES=30
SAGA_TIMEOUT_MINUTES=5

# 캐시 설정
REDIS_TIMEOUT=2000
REDIS_CACHE_TTL_SECONDS=600

# 페이징 설정
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100